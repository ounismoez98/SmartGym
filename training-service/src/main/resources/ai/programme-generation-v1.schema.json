{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "goal", "durationWeeks", "sessions"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "durationWeeks": { "type": "integer", "minimum": 1, "maximum": 52 },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayOrder", "title", "notes", "exercises"],
        "properties": {
          "dayOrder": { "type": "integer", "minimum": 1, "maximum": 7 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "notes": { "type": ["string", "null"], "maxLength": 1000 },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "orderIndex", "exerciseId", "sets", "repetitions",
                "durationSeconds", "restSeconds", "suggestedLoadKg", "notes"
              ],
              "properties": {
                "orderIndex": { "type": "integer", "minimum": 1, "maximum": 20 },
                "exerciseId": { "type": "string", "format": "uuid" },
                "sets": { "type": "integer", "minimum": 1, "maximum": 20 },
                "repetitions": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
                "durationSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 7200 },
                "restSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
                "suggestedLoadKg": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 99999.99 },
                "notes": { "type": ["string", "null"], "maxLength": 500 }
              }
            }
          }
        }
      }
    }
  }
}
