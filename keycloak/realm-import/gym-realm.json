{
  "realm": "gym",
  "enabled": true,
  "displayName": "Smart Gym",
  "loginTheme": "smart-gym",
  "resetPasswordAllowed": false,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' http://localhost:8088; object-src 'none';",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Gym administration and operations" },
      { "name": "COACH", "description": "Training and assigned-member access" },
      { "name": "MEMBER", "description": "Personal gym membership access" }
    ]
  },
  "clients": [
    {
      "clientId": "gym-frontend",
      "name": "Smart Gym Angular application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/",
        "http://localhost:8088/dashboard",
        "http://localhost:8088/membership",
        "http://localhost:8088/courses",
        "http://localhost:8088/training",
        "http://localhost:8088/nutrition",
        "http://localhost:8088/feedback",
        "http://localhost:8088/forbidden",
        "http://localhost:8088/not-found",
        "http://localhost:8088/silent-check-sso.html"
      ],
      "webOrigins": ["http://localhost:8088"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8088/",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["roles", "profile", "email", "api-audience"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "Application realm roles in access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Basic display identity claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "preferred username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email identity claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "api-audience",
      "description": "Audience required by Smart Gym business APIs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Keycloak subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "smart-gym-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "smart-gym-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "gym-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "gym-admin@smartgym.local",
      "firstName": "Gym",
      "lastName": "Administrator",
      "attributes": {
        "developmentOnly": ["true"]
      },
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "gym-coach",
      "enabled": true,
      "emailVerified": true,
      "email": "gym-coach@smartgym.local",
      "firstName": "Gym",
      "lastName": "Coach",
      "attributes": {
        "developmentOnly": ["true"]
      },
      "realmRoles": ["COACH"]
    },
    {
      "username": "member-a",
      "enabled": true,
      "emailVerified": true,
      "email": "member-a@smartgym.local",
      "firstName": "Member",
      "lastName": "A",
      "attributes": {
        "developmentOnly": ["true"]
      },
      "realmRoles": ["MEMBER"]
    }
  ]
}
