# Development-only. Copy to .env and replace every value before starting.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-admin-password
# Optional: set when localhost:8080 is not Keycloak (e.g. Jenkins on WSL using the same port).
# KEYCLOAK_BASE_URL=http://172.19.224.1:8080
POSTGRES_PASSWORD=change-this-local-database-password
PROVISIONING_TOKEN=change-this-long-random-local-provisioning-token
KEYCLOAK_PROVISIONER_SECRET=generate-a-long-random-service-client-secret

# Development account passwords (provision-dev.ps1 only; not used by Compose)
DEV_ADMIN_PASSWORD=change-this-local-gym-admin-password
DEV_COACH_PASSWORD=change-this-local-gym-coach-password
DEV_MEMBER_A_PASSWORD=change-this-local-member-a-password
DEV_MEMBER_B_PASSWORD=change-this-local-member-b-password

# Optional hosted Groq Chat Completions integration. Set GROQ_API_KEY locally;
# never commit a real key. Confirm GROQ_MODEL is available to your Groq account.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen-2.5-32b
APP_LLM_CONNECT_TIMEOUT=5s
APP_LLM_READ_TIMEOUT=120s
RABBITMQ_USER=smartgym
RABBITMQ_PASSWORD=change-this-local-rabbitmq-password
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=replace-with-your-groq-api-key
LLM_TIMEOUT_SECONDS=30
TRAINING_DB_USER=training_service
TRAINING_DB_PASSWORD=change-this-local-training-database-password
OLLAMA_MODEL=qwen2.5:3b
APP_AI_OLLAMA_TIMEOUT=180s
APP_AI_INSIGHTS_TIMEOUT=180s
