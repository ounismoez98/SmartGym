# Development-only. Copy to .env and replace every value before starting.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-admin-password
POSTGRES_PASSWORD=change-this-local-database-password
PROVISIONING_TOKEN=change-this-long-random-local-provisioning-token
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen-2.5-32b

DEV_ADMIN_PASSWORD=replace-with-local-only-admin-password
DEV_COACH_PASSWORD=replace-with-local-only-coach-password
DEV_MEMBER_A_PASSWORD=replace-with-local-only-member-a-password
DEV_MEMBER_B_PASSWORD=replace-with-local-only-member-b-password
RABBITMQ_USER=smartgym
RABBITMQ_PASSWORD=change-this-local-rabbitmq-password
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=replace-with-your-groq-api-key
LLM_TIMEOUT_SECONDS=30
